formulas:
  未命名: ""
views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("日记")
    order:
      - file.name
      - file.ctime
      - file.mtime
      - file.folder
      - formula.未命名
  - type: list
    name: 视图
    filters:
      and:
        - file.inFolder("日记")
    markers: number
    indentProperties: false
